NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Add your key to enable voice-note mapping.
ANTHROPIC_API_KEY=
# Server-only, never exposed to the browser. Supabase project settings → API → service_role key.
# Required for admins to invite users by email (src/app/api/homes/invite). Without it, invites
# are still recorded but no email goes out.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Used to build the invite email's redirect link when not inferable from the request
# (e.g. behind some proxies). Defaults to the request's own origin.
NEXT_PUBLIC_SITE_URL=
